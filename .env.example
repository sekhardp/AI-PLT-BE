# Application settings
APP_NAME=AI-PLT-BE
APP_VERSION=0.1.0
APP_DESCRIPTION=AI Platform Backend

# Logging settings
LOGGING_LEVEL=INFO
LOGGING_LEVELS=module1=DEBUG,module2=INFO
LOGGING_JSON_FORMAT_ENABLED=false

# Database settings
# Required: DB_URL must be set for the app to connect to the database
DB_URL=postgresql+psycopg://user:password@localhost:5432/ai_plt_be
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_AUTO_COMMIT=true
DB_AUTO_FLUSH=true
DB_EXPIRE_ON_COMMIT=false

# Telemetry settings
TELEMETRY_ENABLED=false
TELEMETRY_SERVICE_NAME=AI-PLT-BE
TELEMETRY_SERVICE_VERSION=0.1.0
TELEMETRY_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Endpoint settings
ENDPOINT_HOST=0.0.0.0
ENDPOINT_PORT=8000
